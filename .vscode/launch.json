{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: g++ 生成活动文件",
            "type": "process",
            "command": "D:\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++11",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}